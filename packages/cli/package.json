{
  "name": "@aibridge/cli",
  "version": "0.0.2",
  "description": "CLI that bridges tasks to non-Claude AI CLIs (plan / implement / review / subagent / image-gen)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.11"
  },
  "keywords": [
    "aibridge",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ycmjason/aibridge.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ycmjason/aibridge#readme",
  "bugs": {
    "url": "https://github.com/ycmjason/aibridge/issues"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "aibridge": "./src/cli.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@aibridge/proc": "workspace:*",
    "@aibridge/driver-agy": "workspace:*",
    "@aibridge/driver-grok": "workspace:*",
    "@aibridge/driver-codex": "workspace:*",
    "@aibridge/driver-claude": "workspace:*",
    "@stricli/core": "catalog:"
  },
  "devDependencies": {
    "tsdown": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "aibridge": "./dist/cli.mjs"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    }
  }
}
