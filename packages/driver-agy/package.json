{
  "name": "@aibridge/driver-agy",
  "version": "0.9.0",
  "description": "Antigravity (agy) CLI driver for aibridge",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.11"
  },
  "keywords": [
    "aibridge",
    "antigravity",
    "agy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ycmjason/aibridge.git",
    "directory": "packages/driver-agy"
  },
  "homepage": "https://github.com/ycmjason/aibridge#readme",
  "bugs": {
    "url": "https://github.com/ycmjason/aibridge/issues"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@aibridge/proc": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    }
  }
}
