{
  "name": "@aibridge/grok",
  "version": "0.0.1",
  "description": "xAI Grok CLI driver for aibridge",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.11"
  },
  "keywords": [
    "aibridge",
    "grok",
    "xai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fishballapp/aibridge.git",
    "directory": "packages/grok"
  },
  "homepage": "https://github.com/fishballapp/aibridge#readme",
  "bugs": {
    "url": "https://github.com/fishballapp/aibridge/issues"
  },
  "exports": {
